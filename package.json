{
  "name": "telegram-vanilla-dark-desktop",
  "type": "module",
  "version": "2.0.1",
  "private": true,
  "license": "MIT",
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "generate": "node src/generate.ts",
    "build": "npm run generate all",
